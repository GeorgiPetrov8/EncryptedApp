<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FIX (Bugs #22, #23): Data Protection must be enabled on the target for the
  NSFileProtectionCompleteUntilFirstUserAuthentication attributes applied to the
  database files and the media cache to have any effect. The README instructed the
  reader to tick this by hand in Xcode; making it a checked-in entitlement means a
  fresh `xcodegen generate` can't silently produce a build without it.

  Place at Sources/SecureChat/SecureChat.entitlements.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.default-data-protection</key>
    <string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>
</dict>
</plist>
